# Server options
PORT=3007
NODE_ENV=development
COOKIE_SECRET=my-secret

# Health check
HEALTH_CHECK_ENABLED=false

# Throttler
THROTTLE_GLOBAL_TTL=10000
THROTTLE_GLOBAL_LIMIT=10

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
POSTGRES_SYNCHRONIZE=false
POSTGRES_LOGGING=false
POSTGRES_MIGRATIONS_RUN=true

# SMTP
SMTP_URL=smtp://user:password@smtp.example.com:587
MAIL_FROM="App Name"

# JWT
JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_TTL=604800

# Storage
STORAGE_ROOT=./storage

# Upload size limits (bytes), per source format
UPLOAD_MAX_SIZE_CSV_BYTES=10485760
UPLOAD_MAX_SIZE_JSON_BYTES=10485760
UPLOAD_MAX_SIZE_XML_BYTES=10485760
UPLOAD_MAX_SIZE_YAML_BYTES=10485760
UPLOAD_MAX_SIZE_PNG_BYTES=15728640
UPLOAD_MAX_SIZE_JPEG_BYTES=15728640
UPLOAD_MAX_SIZE_SVG_BYTES=2097152

# Maximum SVG rasterization output dimensions
MAX_RASTER_WIDTH=10000
MAX_RASTER_HEIGHT=10000

# Temp file cleanup: max age (ms) before the startup sweep removes an orphan
TEMP_FILE_MAX_AGE_MS=86400000

# Transformation history / saved-result retention period (ms), default 90 days
HISTORY_RETENTION_MS=7776000000
